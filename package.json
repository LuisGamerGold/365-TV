{
  "name": "365-tv",
  "version": "0.1.0",
  "description": "365 TV - sistema de midia e informacoes para a TV da loja 365 Motos",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "release": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "cookie-session": "^2.1.0",
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "multer": "^2.3.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.1.0": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.motos365.tv",
    "productName": "365 TV",
    "files": [
      "main.js",
      "server/**/*",
      "player/**/*",
      "admin/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "publish": {
      "provider": "github",
      "owner": "LuisGamerGold",
      "repo": "365-tv",
      "releaseType": "release"
    }
  }
}
